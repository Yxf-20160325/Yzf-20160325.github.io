# ===== Better Stack 监控配置（可选）=====
# Heartbeat 上报地址：在 Better Stack 控制台创建 Heartbeat 后复制其 URL。
# 留空或删除该行则不上报，不影响主服务。
BETTERSTACK_HEARTBEAT_URL=

# Heartbeat 上报间隔（毫秒），默认 60000（1 分钟）。
# 注意：Better Stack 控制台的 Grace period（宽限期）必须大于此间隔，
# 否则会因偶发抖动被误判为宕机。建议 Grace period 至少为间隔的 2 倍（如 2 分钟）。
BETTERSTACK_HEARTBEAT_INTERVAL_MS=60000

# ===== 其他现有环境变量（示例，按实际部署填写）=====
# NODE_ENV=production
# PORT=10000
# JWT_SECRET=请生成一个强随机密钥
# CORS_ORIGIN=https://maze-game-apiserver.onrender.com
# DATABASE_URL=mysql://user:pass@host:port/db
